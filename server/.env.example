# Server Configuration
NODE_ENV=development
PORT=5000

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# MongoDB Configuration (will be used in Milestone 5)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/nrityangan?retryWrites=true&w=majority

# JWT Configuration (will be used in Milestone 4)
# Generate JWT_SECRET with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# JWT_SECRET=your-64-character-secret-key-here
# JWT_EXPIRE=7d

# Cloudinary Configuration (will be used in Milestone 5)
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret

# Google OAuth Configuration (will be used in Milestone 4)
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# Google Maps API Configuration (will be used in Milestone 8)
# GOOGLE_MAPS_API_KEY=your-maps-api-key
